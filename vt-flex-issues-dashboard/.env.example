# Frontend (copy to .env.local for local dev, set in Netlify UI for prod)
# Both values are safe to ship to the browser:
#  - VITE_SUPABASE_URL is the project URL (public)
#  - VITE_SUPABASE_ANON_KEY is the publishable key (sb_publishable_...); RLS gates data access
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
